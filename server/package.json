{
  "name": "ghost-support-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hardened Express + Socket.io + Prisma(SQLite) backend for the Ghost TV support portal",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
