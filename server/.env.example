# ---- Server ----
PORT=4000

# Secret used to sign JWTs. CHANGE THIS in production (use a long random string).
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated IPTV usernames that should be treated as support agents/admins.
ADMIN_USERNAMES=Elit,support

# The only origin allowed by CORS (your frontend host).
CLIENT_URL=http://localhost:5173

# Upstream IPTV panel API used to validate subscriber credentials.
IPTV_API_URL=http://ghosttv-con.my/player_api.php
